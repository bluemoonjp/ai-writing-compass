{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "antipattern.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "classification", "tier", "genres", "lang", "rule", "relates_to", "body_lang", "license", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}$" },
    "title": { "$ref": "defs.schema.json#/$defs/bilingualTitle" },
    "status": { "$ref": "defs.schema.json#/$defs/status" },
    "classification": {
      "description": "harmful: a verified source ties this pattern to reader harm. signal_only: only frequency/co-occurrence evidence exists (e.g. an em dash, 体言止め, or \"delve\" spike) -- a detector hint, never enforced as an error. undetermined: candidate, not yet resolved either way. obsolete: classification==harmful with what changed (a superseded practice).",
      "enum": ["harmful", "signal_only", "undetermined", "obsolete"]
    },
    "harmed_tasks": {
      "description": "Required when classification is harmful: which reader tasks this pattern damages.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/readerTask" }
    },
    "signal_for": {
      "description": "Required when classification is signal_only: the harmful antipattern(s) this frequency signal is a proxy for.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/contentRef" }
    },
    "tier": {
      "description": "durable: reader-outcome-based, expected to hold across model versions. model_specific: tied to a pattern observed in particular models/dates; reviewed at each model release.",
      "enum": ["durable", "model_specific"]
    },
    "observed_on": { "$ref": "defs.schema.json#/$defs/date" },
    "observed_models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "genres": { "$ref": "defs.schema.json#/$defs/genreScope" },
    "lang": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/writingLang" }
    },
    "rule": { "$ref": "defs.schema.json#/$defs/bilingualRule" },
    "relates_to": {
      "description": "practice ids this antipattern is the mirror image of.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^\\d{4}$" }
    },
    "body_lang": { "$ref": "defs.schema.json#/$defs/writingLang" },
    "license": { "const": "CC-BY-4.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/source" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "classification": { "const": "harmful" } }, "required": ["classification"] },
      "then": {
        "required": ["harmed_tasks"],
        "properties": { "harmed_tasks": { "type": "array" } }
      }
    },
    {
      "if": {
        "properties": { "classification": { "const": "harmful" }, "status": { "const": "active" } },
        "required": ["classification", "status"]
      },
      "then": {
        "properties": {
          "sources": {
            "type": "array",
            "contains": {
              "type": "object",
              "allOf": [
                { "$ref": "defs.schema.json#/$defs/strongVerified" },
                { "type": "object", "properties": { "supports": { "const": "harm" } }, "required": ["supports"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "classification": { "const": "signal_only" } }, "required": ["classification"] },
      "then": {
        "type": "object",
        "required": ["signal_for"],
        "not": {
          "type": "object",
          "required": ["harmed_tasks"],
          "properties": { "harmed_tasks": { "type": "array" } }
        },
        "properties": {
          "signal_for": { "type": "array" },
          "sources": {
            "type": "array",
            "contains": { "type": "object", "properties": { "supports": { "const": "frequency" } }, "required": ["supports"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "tier": { "const": "model_specific" } }, "required": ["tier"] },
      "then": {
        "required": ["observed_on", "observed_models"],
        "properties": {
          "observed_on": { "type": "string" },
          "observed_models": { "type": "array" }
        }
      }
    },
    {
      "if": { "properties": { "tier": { "const": "durable" } }, "required": ["tier"] },
      "then": {
        "not": {
          "anyOf": [
            {
              "type": "object",
              "required": ["observed_on"],
              "properties": { "observed_on": { "type": "string" } }
            },
            {
              "type": "object",
              "required": ["observed_models"],
              "properties": { "observed_models": { "type": "array" } }
            }
          ]
        }
      }
    }
  ]
}
