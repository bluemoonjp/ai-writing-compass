{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "practice.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "scope", "reader_tasks", "genres", "lang", "rule", "body_lang", "license", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}$", "description": "Must match the leading digits of the file name." },
    "title": { "$ref": "defs.schema.json#/$defs/bilingualTitle" },
    "status": { "$ref": "defs.schema.json#/$defs/status" },
    "scope": {
      "description": "principle: a task-general rule (genres must be [\"any\"]). convention: a rule specific to one or more genres.",
      "enum": ["principle", "convention"]
    },
    "reader_tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/readerTask" }
    },
    "genres": { "$ref": "defs.schema.json#/$defs/genreScope" },
    "lang": {
      "description": "Which written language(s) this practice governs -- not the language its own body prose is written in (see body_lang).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/writingLang" }
    },
    "rule": { "$ref": "defs.schema.json#/$defs/bilingualRule" },
    "core": {
      "description": "Present only on a principle placed in the always-loaded core. Absent means this practice is not rendered into core/*.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "order"],
      "properties": {
        "section": { "enum": ["before", "structure", "certainty", "wording", "format", "ja", "en", "genre"] },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "body_lang": {
      "$ref": "defs.schema.json#/$defs/writingLang",
      "description": "The language of this file's own Why / When it applies prose -- independent of `lang`."
    },
    "license": {
      "const": "CC-BY-4.0",
      "description": "Applies to the original prose of this file's body text."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/source" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "principle" } }, "required": ["scope"] },
      "then": { "properties": { "genres": { "const": ["any"] } } }
    },
    {
      "if": { "properties": { "scope": { "const": "convention" } }, "required": ["scope"] },
      "then": { "properties": { "genres": { "not": { "const": ["any"] } } } }
    },
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": {
        "properties": {
          "sources": {
            "type": "array",
            "contains": {
              "type": "object",
              "allOf": [
                { "$ref": "defs.schema.json#/$defs/strongVerified" },
                { "type": "object", "properties": { "supports": { "const": "rule" } }, "required": ["supports"] }
              ]
            }
          }
        }
      }
    }
  ]
}
