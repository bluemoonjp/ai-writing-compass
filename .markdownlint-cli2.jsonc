{
  "config": {
    "default": true,
    // Prose here wraps at the sentence, not at a fixed column; a line-length
    // limit would fight every practice, antipattern, and ADR body.
    "MD013": false,
    // README.md pairs a 日本語 section and an English section, each with its
    // own "What this is" / "Status" / "License" headings under a different
    // parent.
    "MD024": { "siblings_only": true },
    // CLAUDE.md's first line is deliberately the @AGENTS.md import syntax
    // (instruction-limits enforces this), not a heading.
    "MD041": false
  },
  "globs": ["**/*.md", "**/*.template"],
  "ignores": [
    "scripts/checks/fixtures/**",
    "starter/writing-guard/test-fixtures/**",
    "plugins/*/evals/**",
    "eval/materials/**",
    "eval/reports/**",
    "node_modules/**",
    // Not Markdown content despite the .template extension (JSON/INI
    // config a downstream project copies verbatim) -- see templates/README.md.
    "templates/textlintrc.json.template",
    "templates/vale.ini.template"
  ]
}
